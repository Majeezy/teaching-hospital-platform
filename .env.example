# PostgreSQL connection strings from Neon.
# Dashboard -> your project -> Connect -> "Prisma" tab gives you both of these.
#
# DATABASE_URL: the pooled connection. Used at runtime by the Prisma Neon
#               driver adapter (lib/prisma.ts) -- safe for serverless
#               functions that each open a fresh connection per request.
# DIRECT_URL:   the direct/unpooled connection. Used only by the Prisma CLI
#               (prisma.config.ts) for migrations and introspection --
#               these don't work reliably through a connection pooler.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (NextAuth v4) session signing secret. Generate one with:
#   openssl rand -base64 32
# Required -- both lib/auth.ts and proxy.ts read this directly, and
# next-auth throws at request time in production if it's unset.
NEXTAUTH_SECRET="replace-with-a-32-byte-random-value"

# The canonical URL this app is served from. next-auth v4 can often infer
# this from request headers, but warns on every request if it's unset
# ("[next-auth][warn][NEXTAUTH_URL]") and recommends setting it
# explicitly in production. Not needed for local dev.
NEXTAUTH_URL="https://your-deployment.vercel.app"

# Vercel Blob (patient document uploads, Phase 6 Stage 2). Tells the SDK
# which private store to use. Create one with:
#   vercel blob create-store <name> --access private
# then connect it to the project from the dashboard's Storage tab.
BLOB_STORE_ID="store_xxxxxxxxxxxxxxxxxxxx"

# Short-lived OIDC credential for Vercel-managed resources (Blob),
# refreshed by `vercel env pull .env.local` -- re-run that if local
# uploads start failing with an auth error (expired token), not by
# hand-editing this value. Covers put/get/del/list -- everything except
# client-token generation (see BLOB_READ_WRITE_TOKEN below).
VERCEL_OIDC_TOKEN="eyJ..."

# Static read-write token for the Blob store. Despite OIDC covering
# every other Blob operation, generating a *client upload* token
# (handleUpload, in app/api/documents/upload/route.ts) specifically
# requires this -- OIDC is a bearer credential for direct API calls, not
# a signing secret, and minting a client token needs the latter. Get
# this from the dashboard: Storage tab -> the store -> Tokens.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
