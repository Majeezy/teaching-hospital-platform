# PostgreSQL connection strings from Neon.
# Dashboard -> your project -> Connect -> "Prisma" tab gives you both of these.
#
# DATABASE_URL: the pooled connection. Used at runtime by the Prisma Neon
#               driver adapter (lib/prisma.ts) -- safe for serverless
#               functions that each open a fresh connection per request.
# DIRECT_URL:   the direct/unpooled connection. Used only by the Prisma CLI
#               (prisma.config.ts) for migrations and introspection --
#               these don't work reliably through a connection pooler.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
